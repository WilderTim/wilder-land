<section class="page">
  <h1 class="page__title h-display">{{ 'customer.login' | t }}</h1>
  {%- form 'customer_login', class: 'form' -%}
    <div class="form__errors">{{ form.errors | default_errors }}</div>
    <label class="label" for="LoginEmail">{{ 'customer.email' | t }}</label>
    <input id="LoginEmail" type="email" name="customer[email]" autocomplete="email" required>
    {%- if form.password_needed -%}
      <label class="label" for="LoginPassword">{{ 'customer.password' | t }}</label>
      <input id="LoginPassword" type="password" name="customer[password]" autocomplete="current-password" required>
    {%- endif -%}
    <button class="btn" type="submit">{{ 'customer.login' | t }}</button>
    <a class="link-bracket" href="{{ routes.account_register_url }}">{{ 'customer.register' | t }}</a>
  {%- endform -%}

  <h2 class="h-card text-center" style="margin:60px 0 20px">{{ 'customer.reset' | t }}</h2>
  {%- form 'recover_customer_password', class: 'form' -%}
    {%- if form.posted_successfully? -%}<p class="label">{{ 'customer.reset_sent' | t }}</p>{%- endif -%}
    <div class="form__errors">{{ form.errors | default_errors }}</div>
    <label class="label" for="RecoverEmail">{{ 'customer.email' | t }}</label>
    <input id="RecoverEmail" type="email" name="email" autocomplete="email" required>
    <button class="btn btn--outline" type="submit">{{ 'customer.forgot' | t }}</button>
  {%- endform -%}
</section>
