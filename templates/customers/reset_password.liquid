<section class="page">
  <h1 class="page__title h-display">{{ 'customer.reset' | t }}</h1>
  {%- form 'reset_customer_password', class: 'form' -%}
    <div class="form__errors">{{ form.errors | default_errors }}</div>
    <label class="label" for="ResetPassword">{{ 'customer.new_password' | t }}</label>
    <input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required>
    <label class="label" for="ResetConfirm">{{ 'customer.new_password' | t }} (2×)</label>
    <input id="ResetConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
    <button class="btn" type="submit">{{ 'customer.reset' | t }}</button>
  {%- endform -%}
</section>
