{%- comment -%}
  Product card used in product rows, collections and search.
  - product:  product object (optional — without it the card renders the demo fallback)
  - image:    optional image override (image_picker)
  - fallback: asset used when there is neither an override nor a product image
  - eyebrow / title: optional text overrides
  - show_price: boolean
  - sizes: sizes attribute

  Line 1 comes from the product metafield custom.subtitle (e.g. "Gerookte (on)kruidenthee"),
  falling back to the product type. Product tags that start with "label:" become a badge,
  e.g. "label:Nieuw". Single-variant products get a quick "add to cart" button.
{%- endcomment -%}
{%- liquid
  assign card_image = image | default: product.featured_media
  assign line_1 = eyebrow | default: product.metafields.custom.subtitle.value | default: product.type
  assign line_2 = title | default: product.title
  assign card_url = product.url | default: '#'
  assign badge = ''
  for tag in product.tags
    if tag contains 'label:'
      assign badge = tag | remove_first: 'label:' | strip
      break
    endif
  endfor
  if product and product.available == false
    assign badge = 'products.sold_out' | t
  endif

  assign quick_add = false
  if product and product.available and product.variants.size == 1
    capture b2b_state
      render 'b2b-access'
    endcapture
    unless b2b_state contains 'locked'
      assign quick_add = true
    endunless
  endif
-%}
<div class="product-card"{% if block %} {{ block.shopify_attributes }}{% endif %}>
  <div class="product-card__media-wrap">
    <a class="product-card__link" href="{{ card_url }}"{% unless product %} tabindex="-1" aria-disabled="true"{% endunless %}>
      <div class="product-card__media media media--zoom">
        {% render 'wl-image', image: card_image, fallback: fallback, sizes: sizes, alt: line_2 %}
      </div>
    </a>
    {%- if badge != blank -%}
      <span class="product-card__badge chip">{{ badge }}</span>
    {%- endif -%}
    {%- if quick_add -%}
      <form class="quick-add" method="post" action="{{ routes.cart_add_url }}">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="btn">{{ 'products.quick_add' | t }}</button>
      </form>
    {%- endif -%}
  </div>
  <a class="product-card__link product-card__info" href="{{ card_url }}">
    <div>
      {%- if line_1 != blank -%}<p class="product-card__eyebrow mono">{{ line_1 }}</p>{%- endif -%}
      <p class="product-card__title mono">{{ line_2 }}</p>
    </div>
    {%- if show_price and product -%}
      <span class="product-card__price">{% render 'price', product: product, style: 'card' %}</span>
    {%- endif -%}
  </a>
</div>
