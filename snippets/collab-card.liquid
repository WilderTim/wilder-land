{%- comment -%}
  - variant: 'main' (large, caption below) | 'item' (small, text beside the image)
  - title, image, tags (array), url, fallback, block
{%- endcomment -%}
{%- assign link = url | default: '#' -%}
{%- capture tag_list -%}
  {%- for tag in tags -%}
    {%- assign clean = tag | strip -%}
    {%- if clean != blank -%}<li>{{ clean }}</li>{%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if variant == 'main' -%}
  <article class="collab-main"{% if block %} {{ block.shopify_attributes }}{% endif %}>
    <a href="{{ link }}" class="media media--zoom" tabindex="-1" aria-hidden="true">
      {% render 'wl-image', image: image, fallback: fallback, sizes: '(min-width: 990px) 55vw, 100vw', alt: title %}
    </a>
    <div class="collab-main__meta">
      <div>
        <a href="{{ link }}"><h3 class="h-card">{{ title }}</h3></a>
        <a class="link-bracket" href="{{ link }}">{{ 'general.read_more' | t }}</a>
      </div>
      <ul class="collab-tags" role="list">{{ tag_list }}</ul>
    </div>
  </article>
{%- else -%}
  <a class="collab-item" href="{{ link }}"{% if block %} {{ block.shopify_attributes }}{% endif %}>
    <div class="media media--zoom">
      {% render 'wl-image', image: image, fallback: fallback, sizes: '(min-width: 990px) 20vw, 40vw', alt: title %}
    </div>
    <div class="collab-item__body">
      <h3 class="h-card">{{ title }}</h3>
      <ul class="collab-tags" role="list">{{ tag_list }}</ul>
      <span class="link-bracket">{{ 'general.read_more' | t }}</span>
    </div>
  </a>
{%- endif -%}
