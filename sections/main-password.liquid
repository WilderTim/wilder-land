<section class="big-statement" style="min-height:100vh">
  <div class="big-statement__inner" style="height:100vh">
    <div class="big-statement__media">{% render 'wl-image', image: section.settings.image, fallback: 'wl-bubbles.jpg', loading: 'eager' %}</div>
    <div style="position:absolute;right:max(16px,3vw);top:max(16px,3vw);max-width:320px;display:grid;gap:12px">
      <p class="label">{{ 'general.password_title' | t }}</p>
      {%- if shop.password_message != blank -%}<p class="rte">{{ shop.password_message }}</p>{%- endif -%}
      {%- form 'storefront_password' -%}
        {{ form.errors | default_errors }}
        <label class="visually-hidden" for="Password">{{ 'general.password_label' | t }}</label>
        <div class="newsletter">
          <input id="Password" type="password" name="password" autocomplete="current-password" placeholder="{{ 'general.password_label' | t }}" required>
          <button type="submit">{{ 'general.password_submit' | t }}</button>
        </div>
      {%- endform -%}
    </div>
    <p class="big-statement__text" aria-hidden="true">{{ shop.name }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Wachtwoordpagina",
  "tag": "div",
  "settings": [{ "type": "image_picker", "id": "image", "label": "Afbeelding" }]
}
{% endschema %}
