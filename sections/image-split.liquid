<section class="split page-width">
  {%- for block in section.blocks limit: 2 -%}
    {%- assign fallback = 'wl-split-' | append: forloop.index | append: '.jpg' -%}
    {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="media" {{ block.shopify_attributes }}>
    {%- else -%}<div class="media" {{ block.shopify_attributes }}>{%- endif -%}
      {% render 'wl-image', image: block.settings.image, fallback: fallback, sizes: '(min-width: 750px) 50vw, 100vw', alt: block.settings.alt %}
    {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Twee afbeeldingen",
  "tag": "div",
  "max_blocks": 2,
  "blocks": [
    {
      "type": "image",
      "name": "Afbeelding",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Afbeelding" },
        { "type": "text", "id": "alt", "label": "Alt-tekst" },
        { "type": "url", "id": "link", "label": "Link (optioneel)" }
      ]
    }
  ],
  "presets": [{ "name": "Twee afbeeldingen", "blocks": [{ "type": "image" }, { "type": "image" }] }]
}
{% endschema %}
