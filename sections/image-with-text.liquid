<section class="feature page-width{% if section.settings.layout == 'image_right' %} feature--reverse{% endif %}">
  <div class="feature__media media">
    {% render 'wl-image', image: section.settings.image, fallback: 'wl-perfect-serve.jpg', sizes: '(min-width: 750px) 55vw, 100vw', alt: section.settings.heading %}
  </div>
  <div class="feature__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="feature__eyebrow label">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="feature__heading h-display">{{ section.settings.heading }}</h2>
    <div class="feature__text rte">{{ section.settings.text }}</div>
    {%- if section.settings.link_label != blank -%}
      <div class="feature__link"><a class="link-bracket" href="{{ section.settings.link | default: '#' }}">{{ section.settings.link_label }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Afbeelding met tekst",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Afbeelding" },
    { "type": "select", "id": "layout", "label": "Indeling", "default": "image_left", "options": [
      { "value": "image_left", "label": "Afbeelding links" }, { "value": "image_right", "label": "Afbeelding rechts" }
    ] },
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "Koude dranken" },
    { "type": "text", "id": "heading", "label": "Titel", "default": "The Perfect Serve" },
    {
      "type": "richtext", "id": "text", "label": "Tekst",
      "default": "<p>Serveer Wilder Land goed koud, met veel ijs en een botanische garnish die past bij de smaak. Schenk royaal, neem de tijd en geniet. Het liefst buiten, aan een lange tafel, met goed eten en fijn gezelschap. Serveer Wilder Land goed koud, met veel ijs en een botanische garnish die past bij de smaak. Schenk royaal, neem de tijd en geniet. Het liefst buiten, aan een lange tafel, met goed eten en fijn gezelschap.</p>"
    },
    { "type": "text", "id": "link_label", "label": "Link-tekst", "default": "Lees meer" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Afbeelding met tekst" }]
}
{% endschema %}
