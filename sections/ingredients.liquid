{%- comment -%}
  "Onze natuurlijke ingrediënten" — endless horizontal strip. Blocks are rendered twice
  so the CSS marquee can loop seamlessly; the copy is hidden from screen readers.
{%- endcomment -%}
<section class="ingredients">
  {%- if section.settings.heading != blank -%}
    <h2 class="ingredients__heading h-display">{{ section.settings.heading }}</h2>
  {%- endif -%}
  <div class="marquee">
    <div class="marquee__track" style="--speed: {{ section.settings.speed }}s;">
      {%- for pass in (1..2) -%}
        {%- for block in section.blocks -%}
          {%- liquid
            case forloop.index0
              when 0
                assign demo = 'wl-ingredient-paardenbloem.jpg'
              when 1
                assign demo = 'wl-ingredient-duizendblad.jpg'
              when 2
                assign demo = 'wl-ingredient-vlierbessen.jpg'
              else
                assign demo = 'wl-ingredient-guldenroede.jpg'
            endcase
          -%}
          <div class="ingredient"{% if pass == 2 %} aria-hidden="true"{% else %} {{ block.shopify_attributes }}{% endif %}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="media"{% if pass == 2 %} tabindex="-1"{% endif %}>{%- else -%}<div class="media">{%- endif -%}
              {% render 'wl-image', image: block.settings.image, fallback: demo, sizes: '400px', alt: block.settings.label %}
            {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
            {%- if block.settings.label != blank -%}
              <span class="ingredient__label chip chip--dark">{{ block.settings.label }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ingrediënten",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titel", "default": "Onze natuurlijke ingredienten" },
    { "type": "range", "id": "speed", "label": "Snelheid (seconden per ronde)", "min": 20, "max": 160, "step": 5, "default": 70 }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingrediënt",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Afbeelding" },
        { "type": "text", "id": "label", "label": "Naam", "default": "Duizendblad" },
        { "type": "url", "id": "link", "label": "Link (optioneel)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingrediënten",
      "blocks": [
        { "type": "ingredient", "settings": { "label": "Paardenbloem" } },
        { "type": "ingredient", "settings": { "label": "Duizendblad" } },
        { "type": "ingredient", "settings": { "label": "Vlierbessen" } },
        { "type": "ingredient", "settings": { "label": "Guldenroede" } }
      ]
    }
  ]
}
{% endschema %}
