<section class="section{% if section.settings.flush_top %} section--flush{% endif %}">
  <div class="container trio">
    {%- for block in section.blocks -%}
      {%- liquid
        assign fallback = 'wl-trio-' | append: forloop.index | append: '.jpg'
        if forloop.index > 3
          assign fallback = 'wl-trio-1.jpg'
        endif
        assign item_url = block.settings.link | default: block.settings.product.url
      -%}
      <a class="trio__item" href="{{ item_url | default: '#' }}" {{ block.shopify_attributes }}>
        <div class="media media--contain media--zoom">
          {% render 'wl-image', image: block.settings.image, fallback: fallback, sizes: '(min-width: 750px) 33vw, 100vw', alt: block.settings.title %}
        </div>
        <p class="trio__caption label">
          <span>{{ block.settings.eyebrow }}</span>
          <span>{{ block.settings.title }}</span>
        </p>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Drie afbeeldingen",
  "tag": "div",
  "settings": [{ "type": "checkbox", "id": "flush_top", "label": "Geen ruimte boven", "default": false }],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Afbeelding" },
        { "type": "text", "id": "eyebrow", "label": "Regel 1", "default": "Wild" },
        { "type": "text", "id": "title", "label": "Regel 2", "default": "Tote bag" },
        { "type": "product", "id": "product", "label": "Product (optioneel)" },
        { "type": "url", "id": "link", "label": "Link (optioneel)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Drie afbeeldingen",
      "blocks": [
        { "type": "item", "settings": { "eyebrow": "Gerookte (on)kruidenthee", "title": "Kombucha" } },
        { "type": "item", "settings": { "eyebrow": "Wild", "title": "Tote bag" } },
        { "type": "item", "settings": { "eyebrow": "Wilderland ingredienten", "title": "Boek" } }
      ]
    }
  ]
}
{% endschema %}
