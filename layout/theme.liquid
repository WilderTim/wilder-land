<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_text }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {{ 'instrument-serif-400.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'ibm-plex-mono-400.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {%- comment -%}
      Shopify injects apps, analytics (Customer Events / web pixels), consent banner and
      the storefront API client here. Never remove it.
    {%- endcomment -%}
    {{ content_for_header }}

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
  </head>

  <body class="template-{{ template.name | handle }}{% if template.suffix %} template-{{ template.name | handle }}--{{ template.suffix | handle }}{% endif %} store-mode-{{ settings.store_mode }}">
    <a class="skip-link visually-hidden" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- comment -%} Slide-in cart. Filled by assets/theme.js from Shopify's /cart.js {%- endcomment -%}
    <aside class="cart-drawer" id="CartDrawer" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" data-cart-drawer>
      <div class="cart-drawer__head">
        <h2 class="cart-drawer__title" id="CartDrawerTitle">{{ 'cart.title' | t }}</h2>
        <button class="cart-drawer__close chip chip--outline" type="button" data-cart-close>{{ 'cart.close' | t }}</button>
      </div>
      <div class="cart-drawer__body" data-cart-lines></div>
      <div class="cart-drawer__foot" data-cart-foot hidden>
        <p class="cart-footer__subtotal"><span>{{ 'cart.subtotal' | t }}</span><span data-cart-subtotal></span></p>
        <a class="btn btn--block" href="{{ routes.cart_url }}" data-cart-checkout>{{ 'cart.checkout' | t }}</a>
        <p class="drawer-note">{{ 'cart.taxes_shipping' | t }}</p>
      </div>
    </aside>
    <div class="drawer-backdrop" data-cart-close></div>

    <script>
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }}
        },
        moneyFormat: {{ shop.money_format | json }},
        strings: {
          added: {{ 'cart.added' | t | json }},
          error: {{ 'cart.error' | t | json }},
          empty: {{ 'cart.empty' | t | json }},
          continue: {{ 'cart.continue' | t | json }},
          remove: {{ 'cart.remove' | t | json }},
          quantity: {{ 'products.quantity' | t | json }},
          close: {{ 'general.close' | t | json }}
        }
      };
    </script>
  </body>
</html>
